model Warehouse {
  id        Int          @id @default(autoincrement())
  code      String       @unique
  name      String
  country   String       @db.Char(2)
  stock     StockLevel[]
  shipments Shipment[]

  @@map("warehouses")
  @@schema("inventory")
}

/// Units of a variant on hand in a warehouse.
model StockLevel {
  warehouseId  Int                @map("warehouse_id")
  variantId    Int                @map("variant_id")
  quantity     Int
  reserved     Int                @default(0)
  warehouse    Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  variant      ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  reservations StockReservation[]
  updatedAt    DateTime           @updatedAt @map("updated_at")

  @@id([warehouseId, variantId])
  @@map("stock_levels")
  @@schema("inventory")
}

model StockReservation {
  id          Int        @id @default(autoincrement())
  warehouseId Int        @map("warehouse_id")
  variantId   Int        @map("variant_id")
  orderItemId Int        @unique @map("order_item_id")
  quantity    Int
  expiresAt   DateTime   @map("expires_at")
  stockLevel  StockLevel @relation(fields: [warehouseId, variantId], references: [warehouseId, variantId], onDelete: Cascade)
  orderItem   OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@map("stock_reservations")
  @@schema("inventory")
}
