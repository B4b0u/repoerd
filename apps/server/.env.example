# Local overrides for `pnpm dev`: copy this file to apps/server/.env (git ignores it).
# Values here override apps/server/.env.development; variables set in the shell override both.

# Real GitHub mode: open http://localhost:5173/setup and enter the one-time setup code
# printed in the API logs. Remove this line (or use `fake`) to go back to the fixture repositories.
GITHUB_MODE=real

# Keep real-mode data apart from the fake-mode database: in fake mode the fixed user `dev` is an
# administrator, so a shared database would skip the "first administrator" step of the setup.
DATABASE_PATH=./data/real.sqlite

# Encrypts the GitHub App secrets and the user tokens stored in the database (32 characters or more).
# Keep it for the life of the database: with another key the stored secrets can no longer be read.
# Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SECRET_KEY=

# The Vite dev server proxies /api, /auth and /setup/github to this port: keep 3100.
PORT=3100

# Fake mode only: folder of the fixture repositories (default: fixtures/repos).
# FIXTURES_PATH=../../fixtures/repos
